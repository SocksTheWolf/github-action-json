{
  "name": "github-action-json",
  "version": "1.5.2",
  "description": "Edit or Read the content of any json file or the package.json that you want.",
  "type": "module",
  "scripts": {
    "bundle": "npm run build",
    "build": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "watch": "npm run build -- --watch"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "author": "RadovanPelka & SocksTheWolf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SocksTheWolf/github-action-json"
  },
  "keywords": [
    "actions",
    "package",
    "package.json",
    "json",
    "node",
    "setup",
    "config",
    "configs"
  ],
  "dependencies": {
    "@actions/core": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.3",
    "@types/ramda": "^0.31.1",
    "just-has": "^2.3.0",
    "just-is-empty": "^3.4.1",
    "ramda": "^0.32.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "unset-value": "^2.0.1"
  },
  "overrides": {
    "wrangler": {
      "undici": "^7.29.0"
    },
    "@actions/github": {
      "undici": "^7.29.0"
    },
    "@actions/http-client": {
      "undici": "^7.29.0"
    }
  }
}
